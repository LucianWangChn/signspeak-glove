Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

void setup() {
  Wire.begin();
  if (!display.begin(SSD1306_SWITCHCAPVCC, OLED_ADDR)) {
    pinMode(13, OUTPUT);
    while (1) { digitalWrite(13, !digitalRead(13)); delay(500); }
  }
  display.setRotation(2);
  display.clearDisplay();
  display.display();
}

void loop() {
  for (uint8_t f = 0; f < FRAME_COUNT; f++) {
    display.clearDisplay();
    display.drawBitmap(0, 0, (const uint8_t*)pgm_read_ptr(&frames[f]), SCREEN_WIDTH, SCREEN_HEIGHT, SSD1306_WHITE);
    display.display();
    delay(FRAME_DELAY_MS);
  }
}
